# Copy to .env locally. Keep secrets outside source control.
PYTHON_IMAGE=python:3.11-slim
PGVECTOR_IMAGE=pgvector/pgvector:0.8.1-pg17
AUTH_PRINCIPALS_FILE=/run/secrets/principals.json
RAG_BASE_URL=http://rag:8000
# Set true only when these HTTP endpoints are on a trusted private network.
ALLOW_INTERNAL_HTTP=true
ALLOW_MODEL_HTTP=false
# Disabled is explicit: /v1/reports returns 503 until configured.
REPORTS_ENABLED=false
# Optional LangChain tool routing. Requires a model supporting native tool_calls.
ASSISTANT_ENABLED=false
USAGE_API_BASE_URL=https://usage.example.internal
USAGE_API_TOKEN_FILE=/run/secrets/usage_api_token
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_API_KEY_FILE=/run/secrets/model_api_key
MODEL_NAME=qwen-plus
CHAT_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024
MAX_COSINE_DISTANCE=0.45
REQUEST_TIMEOUT_SECONDS=120
UPSTREAM_TIMEOUT_SECONDS=110
MAX_CONCURRENT_REQUESTS=16
REQUESTS_PER_MINUTE=30
MODEL_MAX_TOKENS=800
